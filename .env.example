# Copy to .env and adjust. Never commit real secrets.
AGENT_ENV=dev
AGENT_TIMEZONE=Asia/Kolkata
AGENT_LOG_LEVEL=INFO

# NLU engine (Phase 3):
#   stub   - typed commands only (Phase 2 tests)
#   rules  - deterministic regex/dictionary NLU, fully offline
#   hybrid - rules first, Gemini only for what the rules cannot answer (default).
#            Without an API key (or without google-genai installed) it runs rules-only.
AGENT_NLU_ENGINE=hybrid
AGENT_NLU_CONFIDENCE_THRESHOLD=0.7
AGENT_NLU_TIMEOUT_S=4.0

# Gemini (Google AI Studio key). GEMINI_API_KEY / GOOGLE_API_KEY are also accepted.
# AGENT_GEMINI_API_KEY=your-key-here
# Alias for the newest Gemini Flash; pin an exact model in prod for reproducibility.
AGENT_GEMINI_MODEL=gemini-flash-latest
# Gemini 3 thinking level (minimal | low | medium | high). Leave empty to omit it.
AGENT_GEMINI_THINKING_LEVEL=minimal

# Domain
AGENT_SLOT_DURATION_MIN=30
AGENT_BUSINESS_HOURS=[9,18]
AGENT_BOOKING_HORIZON_DAYS=14
AGENT_LEAD_TIME_MIN=120
AGENT_MOCK_CALENDAR_PATH=data/mock_calendar.json

# Sessions
AGENT_SESSION_TTL_MIN=30

# Write golden chat transcripts to tests/golden/ (test/dev only)
AGENT_RECORD_GOLDEN=0

# ---------------------------------------------------------------------------------------------
# Phase 3B/4: real Google tools through our own FastMCP server (Calendar, Docs, Gmail drafts).
# Off by default: confirming a slot then only reads the booking back (no side effects).
# AGENT_MCP_TOOLS_ENABLED=true
#   inprocess (default) = FastMCP server object in this process
#   src/advisor_agent/mcp_server/server.py = spawn it over stdio
#   http://127.0.0.1:8001/mcp = a separately running `agent-mcp-server --transport http`
# AGENT_MCP_SERVER_TARGET=inprocess
# AGENT_MCP_LLM_TOOL_CALLING=true       # Gemini proposes the tool calls; the ToolGate enforces the plan
# AGENT_MCP_MAX_TOOL_CALLS_PER_TURN=4
# AGENT_MCP_CALL_TIMEOUT_S=10
# AGENT_MCP_AGENT_TIMEOUT_S=6

# Google (OAuth desktop client; run `python -m advisor_agent.mcp_server.google_auth` once)
# AGENT_GOOGLE_CALENDAR_ID=primary
# AGENT_GOOGLE_PREBOOKING_DOC_ID=your-google-doc-id        # the "Advisor Pre-Bookings" doc
# AGENT_GOOGLE_ADVISOR_EMAIL=advisor@example.com           # recipient of the drafts (never sent)
# AGENT_GOOGLE_CREDENTIALS_FILE=secrets/google_oauth_client.json
# AGENT_GOOGLE_TOKEN_FILE=secrets/google_token.json
# Or a service account (Workspace domain-wide delegation):
# AGENT_GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# AGENT_GOOGLE_DELEGATED_USER=advisor@yourdomain.com

# Phase 4: booking store, outbox, secure link, PII vault
# AGENT_DATABASE_URL=sqlite:///./data/agent.db
# AGENT_OUTBOX_POLL_S=1.0
# AGENT_PUBLIC_BASE_URL=http://localhost:8000              # base of the secure link /b/{code}?t=...
# AGENT_LINK_TTL_HOURS=48
# Required in prod; in dev an ephemeral value is generated (links/vault die on restart).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_LINK_HMAC_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AGENT_VAULT_FERNET_KEY=

# Phase 5/6: waitlist + secondary intents
# AGENT_WAITLIST_MODE=hold            # hold = transparent "Waitlist" calendar marker + notes + draft; notes_only = notes + draft
# AGENT_CANCEL_DRAFT_ENABLED=true     # also draft an advisor email when a booking is cancelled
